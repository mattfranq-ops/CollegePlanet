# Copy this file to .env and fill in the values. Never commit .env.
# The Firebase web config is in Firebase console > Project settings > General > Your apps.

# --- Server (Next.js API routes, seed script, tests) ---
# Firebase project id used by the Admin SDK.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Point the Admin SDK at the local emulator. Remove this line to use the real database.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Only needed against the real database: path to a service account key kept OUTSIDE the repo.
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/you/keys/collegeplanet-service-account.json

# Signs the login session cookie. Use a long random string.
SESSION_SECRET=replace-with-a-long-random-string

# --- Firebase web app config (public identifiers, for browser-side Firebase features) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
